# =============================================================================
# Django Settings
# =============================================================================

# Enable Django debug mode (enables template reloading, detailed error pages)
DEBUG=True

# Django secret key (required in production - generate a secure random key)
SECRET_KEY=your-secret-key-here

# =============================================================================
# Database (optional - defaults to SQLite)
# =============================================================================

# PostgreSQL connection URL for production
# Example: postgres://user:password@host:5432/dbname
# DATABASE_URL=

# =============================================================================
# IGDB API (required for game metadata)
# =============================================================================

# Get credentials at https://api-docs.igdb.com/
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Enable IGDB Pro tier for higher rate limits (default: False)
IGDB_USE_PRO_TIER=False

# =============================================================================
# Wikipedia/Wikidata (optional - improves rate limits)
# =============================================================================

# Wikidata OAuth access token for faster Wikipedia processing
# See https://www.wikidata.org/wiki/Wikidata:Creating_a_bot for setup
# WIKIDATA_ACCESS_TOKEN=

# =============================================================================
# Feature Flags
# =============================================================================

# Enable books app (default: False)
# Auto-enabled when DEBUG=True or when running pytest
# BOOKS_ENABLED=False

# =============================================================================
# Books Integrations (optional)
# =============================================================================

# Hardcover GraphQL API token for additional book metadata
# HARDCOVER_API_TOKEN=

# =============================================================================
# Error Tracking (optional)
# =============================================================================

# Sentry DSN for error tracking in production
# SENTRY_DSN=

# =============================================================================
# Email (optional - required for production contact/password reset emails)
# =============================================================================

# Brevo SMTP username (not secret)
# BREVO_SMTP_USER=

# Brevo SMTP API key/password
# BREVO_SMTP_KEY=

# =============================================================================
# Cache (optional - defaults to local memory)
# =============================================================================

# Redis cache URL for production
# Example: redis://localhost:6379/0
# CACHE_URL=

# =============================================================================
# CORS (optional - for API access from other domains)
# =============================================================================

# Comma-separated list of allowed origins
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
