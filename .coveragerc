[run]
source = games,books,core
omit =
    */migrations/*
    */tests/*
    */management/commands/*
    games/admin.py
    books/admin.py
    games/services/llm_quote_service.py
    games/services/wiki_page_lookup_service.py
    games/services/import_handler.py
    games/csp_middleware.py
    games/mixins.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    warnings.warn
